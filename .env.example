# NORTHSTREAM - model selection (template)
#
# Copy this file to ".env" in the repository root; docker compose loads it
# automatically and the Stream Context Agent picks up the two variables below.
# ".env" itself is git-ignored on purpose, so switching tier locally never
# shows up as a repository change.
#
#   cp .env.example .env
#
# The values here match the Recommended tier, which is also what the compose
# files fall back to when no .env exists:
#
#   RAM:    32 GB
#   CPU:    8
#   Disk:   50 GB free
#   GPU:    not required
#
# For another tier, copy the corresponding file instead — examples/minimal/.env,
# examples/recommended/.env or examples/optimal/.env — which carry the per-tier
# hardware notes alongside the same two variables.
OLLAMA_CHAT_MODEL=granite4:1b
OLLAMA_EMBED_MODEL=granite-embedding:30m
