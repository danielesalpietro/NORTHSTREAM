# NORTHSTREAM - Minimal tier
#
# Recommended hardware for this tier:
#   RAM:    16 GB
#   CPU:    4 cores / vCPUs
#   VRAM:   not required (CPU inference)
#   GPU:    none needed
#
# Use together with examples/minimal/.wslconfig (Windows/WSL2) for consistent
# resource limits.
#
# Copy this file to the repository root as ".env" (docker compose loads it
# automatically) to select the models used by the Stream Context Agent.
OLLAMA_CHAT_MODEL=granite4:350m
OLLAMA_EMBED_MODEL=granite-embedding:30m
